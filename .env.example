# NEXT_PUBLIC_API_URL: base URL of the backend API (local or deployed)
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: must match backend .env exactly

# Backend API URL (local dev or production)
# NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=https://fixitnow-gamma.vercel.app

# JWT secrets - MUST match backend .env exactly
JWT_ACCESS_SECRET=access_secret
JWT_REFRESH_SECRET=refresh_secret
